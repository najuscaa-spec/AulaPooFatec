import java.util.Scanner;

public class Exercicio19 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int[][] matriz = new int[3][3];
        boolean ehIdentidade = true;

        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                System.out.print("Matriz[" + i + "][" + j + "]: ");
                matriz[i][j] = scanner.nextInt();
            }
        }

        // Validação da Identidade (1 na diagonal principal e 0 no resto)
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                if (i == j && matriz[i][j] != 1) ehIdentidade = false;
                if (i != j && matriz[i][j] != 0) ehIdentidade = false;
            }
        }

        if (ehIdentidade) {
            System.out.println("É uma matriz identidade.");
        } else {
            System.out.println("NÃO é uma matriz identidade.");
        }
        scanner.close();
    }
}
