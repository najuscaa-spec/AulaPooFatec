import java.util.Random;
import java.util.Scanner;

public class Exercicio12 {

    public static void main(String[] args) {
        mostrarMenu();
        int jogador = jogadaJogador();
        int computador = jogadaComputador();
        
        String resultado = verificarVencedor(jogador, computador);
        mostrarResultado(jogador, computador, resultado);
    }

    public static void mostrarMenu() {
        System.out.println("--- JOKEMPÔ ---");
        System.out.println("1 - Pedra\n2 - Papel\n3 - Tesoura");
    }

    public static int jogadaJogador() {
        Scanner scanner = new Scanner(System.in);
        System.out.print("Sua escolha: ");
        return scanner.nextInt();
    }

    public static int jogadaComputador() {
        Random random = new Random();
        return random.nextInt(3) + 1; // Sorteia entre 1 e 3
    }

    public static String verificarVencedor(int jogada1, int jogada2) {
        if (jogada1 == jogada2) return "Empate";
        
        // Regras tradicionais de vitória
        if ((jogada1 == 1 && jogada2 == 3) || 
            (jogada1 == 2 && jogada2 == 1) || 
            (jogada1 == 3 && jogada2 == 2)) {
            return "Jogador";
        }
        return "Computador";
    }

    public static void mostrarResultado(int jogJogador, int jogComp, String vencedor) {
        String[] opcoes = {"", "Pedra", "Papel", "Tesoura"};
        System.out.println("Você escolheu: " + opcoes[jogJogador]);
        System.out.println("Computador escolheu: " + opcoes[jogComp]);
        
        if (vencedor.equals("Empate")) {
            System.out.println("Resultado: Deu empate!");
        } else {
            System.out.println("Vencedor: O " + vencedor + " ganhou!");
        }
    }
}
