import java.util.Scanner;

public class Exercicio06 {

    public static void main(String[] args) {
        int numero = lerNumero();
        exibirTabuada(numero);
    }

    public static int lerNumero() {
        Scanner scanner = new Scanner(System.in);
        System.out.print("Deseja a tabuada de qual número? ");
        return scanner.nextInt();
    }

    public static void exibirTabuada(int numero) {
        System.out.println("Tabuada do " + numero + ":");
        for (int i = 1; i <= 10; i++) {
            mostrarLinha(numero, i);
        }
    }

    public static void mostrarLinha(int numero, int multiplicador) {
        int resultado = numero * multiplicador;
        System.out.println(numero + " x " + multiplicador + " = " + resultado); // Exemplo: 5 x 1 = 5 [cite: 108]
    }
}
