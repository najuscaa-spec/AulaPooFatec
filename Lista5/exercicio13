public class Exercicio13 {

    public static int vidaPersonagem;
    public static String nomePersonagem;

    public static void main(String[] args) {
        criarPersonagem("Guerreiro", 100);
        mostrarStatus();
        
        atacar();
        receberDano(30);
        mostrarStatus();
        
        curar(15);
        mostrarStatus();
    }

    public static void criarPersonagem(String nome, int vidaInicial) {
        nomePersonagem = nome;
        vidaPersonagem = vidaInicial;
        System.out.println(nomePersonagem + " entrou no mundo!");
    }

    public static void mostrarStatus() {
        System.out.println("Status atual -> " + nomePersonagem + " | HP: " + vidaPersonagem);
    }

    public static void atacar() {
        System.out.println(nomePersonagem + " desferiu um ataque crítico!");
    }

    public static void receberDano(int dano) {
        vidaPersonagem -= dano;
        System.out.println(nomePersonagem + " recebeu " + dano + " de dano!");
        if (vidaPersonagem <= 0) {
            System.out.println(nomePersonagem + " foi derrotado.");
        }
    }

    public static void curar(int cura) {
        vidaPersonagem += cura;
        System.out.println(nomePersonagem + " usou uma poção e recuperou " + cura + " de HP!");
    }
}
