import java.util.Scanner;

public class Exercicio14 {

    public static double saldoConta = 500.00; // Começa com um dinheirinho

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        boolean rodando = true;

        while (rodando) {
            mostrarMenu();
            System.out.print("Escolha uma operação: ");
            int opcao = scanner.nextInt();

            switch (opcao) {
                case 1 -> consultarSaldo();
                case 2 -> {
                    System.out.print("Valor do depósito: ");
                    depositar(scanner.nextDouble());
                }
                case 3 -> {
                    System.out.print("Valor do saque: ");
                    sacar(scanner.nextDouble());
                }
                case 4 -> rodando = encerrarSistema();
                default -> System.out.println("Opção incorreta.");
            }
        }
    }

    public static void mostrarMenu() {
        System.out.println("\n--- CAIXA ELETRÔNICO ---");
        System.out.println("1 - Saldo\n2 - Depositar\n3 - Sacar\n4 - Sair");
    }

    public static void consultarSaldo() {
        System.out.printf("Saldo disponível: R$ %.2f\n", saldoConta);
    }

    public static void depositar(double valor) {
        if (valor > 0) {
            saldoConta += valor;
            System.out.println("Valor creditado.");
        }
    }

    public static void sacar(double valor) {
        if (valor > 0 && valor <= saldoConta) {
            saldoConta -= valor;
            System.out.println("Saque aprovado. Retire as cédulas.");
        } else {
            System.out.println("Saldo insuficiente.");
        }
    }

    public static boolean encerrarSistema() {
        System.out.println("Obrigado por utilizar nosso Caixa Eletrônico. Volte sempre!");
        return false; // Retorna false para quebrar o loop 'while' do main
    }
}
