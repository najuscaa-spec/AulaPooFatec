import java.util.Scanner;

public class Exercicio21 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        char[][] tabuleiro = {
            {' ', ' ', ' '},
            {' ', ' ', ' '},
            {' ', ' ', ' '}
        };
        char jogadorAtual = 'X';
        boolean jogoAtivo = true;

        while (jogoAtivo) {
            // Imprime tabuleiro
            System.out.println("\n  0   1   2");
            for (int i = 0; i < 3; i++) {
                System.out.println(i + " " + tabuleiro[i][0] + " | " + tabuleiro[i][1] + " | " + tabuleiro[i][2]);
                if (i < 2) System.out.println(" ---+---+---");
            }

            System.out.print("\nJogador '" + jogadorAtual + "', insira linha e coluna (ex: 0 1): ");
            int l = scanner.nextInt();
            int c = scanner.nextInt();

            if (l >= 0 && l < 3 && c >= 0 && c < 3 && tabuleiro[l][c] == ' ') {
                tabuleiro[l][c] = jogadorAtual;
                
                // Verifica vitória simples
                boolean vitoria = false;
                for (int i = 0; i < 3; i++) {
                    if (tabuleiro[i][0] == jogadorAtual && tabuleiro[i][1] == jogadorAtual && tabuleiro[i][2] == jogadorAtual) vitoria = true;
                    if (tabuleiro[0][i] == jogadorAtual && tabuleiro[1][i] == jogadorAtual && tabuleiro[2][i] == jogadorAtual) vitoria = true;
                }
                if (tabuleiro[0][0] == jogadorAtual && tabuleiro[1][1] == jogadorAtual && tabuleiro[2][2] == jogadorAtual) vitoria = true;
                if (tabuleiro[0][2] == jogadorAtual && tabuleiro[1][1] == jogadorAtual && tabuleiro[2][0] == jogadorAtual) vitoria = true;

                if (vitoria) {
                    System.out.println("\nJogador '" + jogadorAtual + "' VENCEU!");
                    jogoAtivo = false;
                } else {
                    jogadorAtual = (jogadorAtual == 'X') ? 'O' : 'X';
                }
            } else {
                System.out.println("Movimento inválido!");
            }
        }
        scanner.close();
    }
}
