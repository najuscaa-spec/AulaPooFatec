import java.util.Scanner;

public class Exercicio09 {

    // Usamos uma variável global (static) para simular o saldo do banco de forma simples
    public static double saldo = 0.0;

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int opcao;

        do {
            mostrarMenu();
            System.out.print("Opção: ");
            opcao = scanner.nextInt();

            switch (opcao) {
                case 1 -> consultarSaldo();
                case 2 -> {
                    System.out.print("Valor para depositar: ");
                    double valorDep = scanner.nextDouble();
                    depositar(valorDep);
                }
                case 3 -> {
                    System.out.print("Valor para sacar: ");
                    double valorSac = scanner.nextDouble();
                    sacar(valorSac);
                }
                case 4 -> System.out.println("Sistema encerrado.");
                default -> System.out.println("Opção inválida.");
            }
        } while (opcao != 4);
    }

    public static void mostrarMenu() {
        System.out.println("\n--- BANCO DIGITAL ---");
        System.out.println("1 - Consultar Saldo\n2 - Depositar\n3 - Sacar\n4 - Sair");
    }

    public static void consultarSaldo() {
        System.out.printf("Seu saldo atual é: R$ %.2f\n", saldo);
    }

    public static void depositar(double valor) {
        if (valor > 0) {
            saldo += valor;
            System.out.println("Depósito realizado com sucesso!");
        } else {
            System.out.println("Valor inválido para depósito.");
        }
    }

    public static void sacar(double valor) {
        if (valor > 0 && valor <= saldo) {
            saldo -= valor;
            System.out.println("Saque realizado com sucesso!");
        } else {
            System.out.println("Saldo insuficiente ou valor inválido.");
        }
    }
}
