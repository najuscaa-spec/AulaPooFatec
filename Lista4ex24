import java.util.Scanner;

public class Exercicio24 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int[][] matriz = new int[5][5];

        System.out.println("Insira os dados da matriz 5x5:");
        for (int i = 0; i < 5; i++) {
            for (int j = 0; j < 5; j++) {
                matriz[i][j] = scanner.nextInt();
            }
        }

        System.out.print("Digite o número a procurar: ");
        int alvo = scanner.nextInt();
        boolean achou = false;

        for (int i = 0; i < 5; i++) {
            for (int j = 0; j < 5; j++) {
                if (matriz[i][j] == alvo) {
                    System.out.println("Encontrado na Linha: " + i + ", Coluna: " + j);
                    achou = true;
                }
            }
        }

        if (!achou) System.out.println("Número não encontrado.");
        scanner.close();
    }
}
