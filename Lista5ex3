import java.util.Scanner;

public class Exercicio03 {

    public static void main(String[] args) {
        int numero = lerNumero();
        boolean resultadoEhPar = ehPar(numero);
        mostrarResultado(numero, resultadoEhPar);
    }

    public static int lerNumero() {
        Scanner scanner = new Scanner(System.util.System.in);
        System.out.print("Digite um número: ");
        return scanner.nextInt();
    }

    public static boolean ehPar(int numero) {
        return numero % 2 == 0; // Retorna true se for par e false se for ímpar
    }

    public static void mostrarResultado(int numero, boolean resultadoEhPar) {
        if (resultadoEhPar) {
            System.out.println("O número " + numero + " é PAR.");
        } else {
            System.out.println("O número " + numero + " é ÍMPAR.");
        }
    }
}
