import java.util.Random;
import java.util.Scanner;

public class CofreMisterioso {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);
        Random random = new Random();

        boolean continuar = true;

        while (continuar) {

            int numeroSecreto = random.nextInt(50) + 1;
            boolean acertou = false;

            System.out.println("\n=== COFRE MISTERIOSO ===");
            System.out.println("Tente descobrir o número secreto entre 1 e 50!");

            for (int tentativa = 5; tentativa > 0; tentativa--) {

                int palpite;

                while (true) {
                    System.out.print("\nDigite seu palpite: ");

                    if (scanner.hasNextInt()) {
                        palpite = scanner.nextInt();
                        break;
                    } else {
                        System.out.println("Entrada inválida! Digite apenas números.");
                        scanner.next();
                    }
                }

                if (palpite == numeroSecreto) {
                    System.out.println("Cofre aberto! Você acertou!");
                    acertou = true;
                    break;
                }

                if (palpite < numeroSecreto) {
                    System.out.println("O código é MAIOR.");
                } else {
                    System.out.println("O código é MENOR.");
                }

                System.out.println("Restam " + (tentativa - 1) + " tentativa(s).");
            }

            if (!acertou) {
                System.out.println("\nSuas tentativas acabaram!");
                System.out.println("O número secreto era: " + numeroSecreto);
            }

            String resposta;

            do {
                System.out.print("\nDeseja jogar novamente? (s/n): ");
                resposta = scanner.next().toLowerCase();

                if (!resposta.equals("s") && !resposta.equals("n")) {
                    System.out.println("Digite apenas 's' ou 'n'.");
                }

            } while (!resposta.equals("s") && !resposta.equals("n"));

            continuar = resposta.equals("s");
        }

        System.out.println("\nObrigado por jogar!");
        scanner.close();
    }
}
